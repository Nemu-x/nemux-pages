---
import { cn, withBase } from '~/lib/utils'

type Props = {
  href: string
  class?: string
  background?: boolean
  [key: string]: any
}

const { href, class: className, background, ...props }: Props = Astro.props
const resolvedHref = withBase(href)
const isActive =
  href === '/'
    ? Astro.url.pathname === resolvedHref || Astro.url.pathname === `${resolvedHref}/`
    : Astro.url.pathname.startsWith(resolvedHref)
---

<a
  href={resolvedHref}
  class={cn(
    'text-sm px-2 sm:px-4 py-2 font-medium',
    background && 'transition-colors text-foreground/50 hover:bg-accent hover:text-foreground',
    isActive && 'text-foreground',
    className
  )}
  rel="prefetch"
  {...props}
>
  <slot />
</a>
